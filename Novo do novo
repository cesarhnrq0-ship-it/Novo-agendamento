<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Barbearia Di'Quebrada — Agendamento</title>
<style>
:root{--bg:#ECE9F1;--card:#fff;--ink:#2A1B3D;--mute:#6B607A;--line:#D9D3E3;--acc:#2A1B3D;--acc-ink:#fff;--pop:#7FD1B9;--pop-ink:#123;--danger:#C0392B}
@media (prefers-color-scheme:dark){:root{--bg:#181120;--card:#241A30;--ink:#F1ECF7;--mute:#A79CB8;--line:#3A2E4A;--acc:#7FD1B9;--acc-ink:#123;--danger:#E74C3C}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.45 system-ui,-apple-system,sans-serif;display:flex;flex-direction:column;height:100vh}
header{padding:14px 16px;border-bottom:1px solid var(--line);background:var(--card);display:flex;justify-content:space-between;align-items:center}
header b{font-size:18px}header div{color:var(--mute);font-size:13px}
#log{flex:1;overflow-y:auto;padding:16px;max-width:640px;width:100%;margin:0 auto;scroll-behavior:smooth}
.m{max-width:85%;padding:10px 13px;border-radius:16px;margin:0 0 10px;white-space:pre-line}
.bot{background:var(--card);border:1px solid var(--line);border-bottom-left-radius:4px}
.me{background:var(--acc);color:var(--acc-ink);margin-left:auto;border-bottom-right-radius:4px}
#dock{border-top:1px solid var(--line);background:var(--card);padding:12px 16px;max-height:45vh;overflow-y:auto}
#dock>div{max-width:640px;margin:0 auto}
.chips{display:flex;flex-wrap:wrap;gap:8px}
button,input{font:inherit}
.chip{background:transparent;color:var(--ink);border:1.5px solid var(--line);border-radius:999px;padding:9px 14px;cursor:pointer}
.chip:disabled{opacity:.4;text-decoration:line-through;cursor:not-allowed}
.chip:hover:not(:disabled){border-color:var(--pop)}
form{display:flex;flex-direction:column;gap:8px}
input{color:var(--ink);background:transparent;border:1.5px solid var(--line);border-radius:10px;padding:11px}
.send{background:var(--acc);color:var(--acc-ink);border:0;border-radius:10px;padding:11px;font-weight:600;cursor:pointer}
a.wa, a.cal, button.del-btn{display:block;text-align:center;text-decoration:none;font-weight:600;padding:12px;border-radius:10px;margin-top:8px;width:100%;border:none;font-size:14px;cursor:pointer}
a.wa{background:var(--pop);color:var(--pop-ink)}
a.cal{background:var(--acc);color:var(--acc-ink)}
button.del-btn{background:var(--danger);color:#fff}
.err{color:var(--danger);font-size:14px;margin:0}
.admin-btn{background:none;border:none;color:var(--mute);font-size:12px;cursor:pointer;text-decoration:underline}

/* CARTOES DO ADMIN PARA CELULAR */
.admin-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px;display:flex;flex-direction:column;gap:6px}
.admin-card-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:6px;font-weight:bold}
.admin-card-body{font-size:14px;color:var(--mute)}
.admin-card-body b{color:var(--ink)}
.btn-card-del{background:var(--danger);color:#fff;border:none;padding:8px;border-radius:8px;cursor:pointer;font-weight:bold;margin-top:6px;font-size:13px}
</style>
<!-- Firebase SDKs -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
</head>
<body>

<header>
  <div>
    <b>Barbearia Di'Quebrada</b>
    <div>Assistente de agendamento</div>
  </div>
  <button class="admin-btn" onclick="openAdmin()">Área do Admin</button>
</header>

<div id="log" aria-live="polite"></div>
<div id="dock"><div id="ctl"></div></div>

<script>
const firebaseConfig = {
  databaseURL: "https://agendamento-fio-certo-default-rtdb.firebaseio.com/"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.database();

var SALON = "5511989448738";
var ADMIN_PASS = "123456";
var SV = [["Corte masculino",45,40],["Corte feminino",90,60],["Barba",30,30],["Corte + barba",70,70],["Escova",60,45],["Coloração",150,120]];
var DOW = ["dom","seg","ter","qua","qui","sex","sáb"], MES = ["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"];
var S = {}; 
var log = document.getElementById("log"), ctl = document.getElementById("ctl");

function say(t,who){
  var d=document.createElement("div");d.className="m "+(who||"bot");d.textContent=t;log.appendChild(d);
  log.scrollTo({top:log.scrollHeight,behavior:'smooth'});
}
function iso(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
function lbl(d){return DOW[d.getDay()]+", "+d.getDate()+" "+MES[d.getMonth()]}

function chips(items,cb){ctl.innerHTML="";var w=document.createElement("div");w.className="chips";
  items.forEach(function(it){var b=document.createElement("button");b.className="chip";b.textContent=it.t;b.disabled=!!it.off;
    b.onclick=function(){say(it.t,"me");cb(it)};w.appendChild(b)});ctl.appendChild(w)}

function askMulti(fields,cb){
  ctl.innerHTML="";var f=document.createElement("form"),e=document.createElement("p");e.className="err";
  var inputs={};
  fields.forEach(function(fld){
    var i=document.createElement("input");i.placeholder=fld.ph;i.type=fld.type||"text";
    inputs[fld.key]=i;f.appendChild(i);
  });
  var b=document.createElement("button");b.className="send";b.textContent="Continuar";
  f.appendChild(b);f.appendChild(e);ctl.appendChild(f);
  f.onsubmit=function(ev){
    ev.preventDefault();
    for(var k in inputs){if(!inputs[k].value.trim()){e.textContent="Preencha todos os campos.";return}}
    cb(inputs);
  }
}

function start(){
  S={};
  log.innerHTML = "";
  say("Oi! Eu sou o assistente da Barbearia Di'Quebrada. O que gostaria de fazer?");
  chips([
    {t:"Agendar novo horário", act:"new"},
    {t:"Cancelar meu agendamento", act:"cancel"}
  ], function(it){
    if(it.act === "new") selectService();
    else cancelByClient();
  });
}

function selectService(){
  say("Qual serviço você quer?");
  chips(SV.map(function(s,i){return{t:s[0]+" · R$ "+s[1],i:i}}),function(it){S.svc=SV[it.i];pickDay()});
}

function pickDay(){
  say("Ótimo, "+S.svc[0]+". Para qual dia?");
  var days=[], base = new Date();
  base.setHours(0,0,0,0);

  for(var k=0; k<14 && days.length<10; k++){
    var d = new Date(base.getTime() + k*86400000);
    if(d.getDay() !== 0) days.push(d);
  }
  chips(days.map(function(d){return{t:lbl(d),d:d}}),function(it){S.date=it.d;pickTime()})
}

function pickTime(){
  var d=S.date, dateKey=iso(d), end=d.getDay()===6?15:18, now=new Date();
  
  db.ref('agendamentos/' + dateKey).once('value', function(snapshot){
    var dayBookings = snapshot.val() || {};
    var items = [];

    for(var m=9*60;m<end*60;m+=30){
      var t=String(Math.floor(m/60)).padStart(2,"0")+":"+String(m%60).padStart(2,"0");
      var past=iso(now)===dateKey&&m<=(now.getHours()*60+now.getMinutes());
      var isTaken = dayBookings[t.replace(":","")] !== undefined;
      
      items.push({t:t, off: past || isTaken});
    }

    if(items.every(function(x){return x.off})){
      say("Esse dia está totalmente lotado. Vamos tentar outro?");
      return pickDay();
    }
    say("Horários disponíveis em "+lbl(d)+":");
    chips(items,function(it){S.time=it.t;getUserData()});
  });
}

function getUserData(){
  say("Por favor, informe seu Nome, E-mail e WhatsApp:");
  askMulti([
    {key:"nome", ph:"Seu nome completo"},
    {key:"email", ph:"Seu e-mail", type:"email"},
    {key:"tel", ph:"Seu WhatsApp (ex: 11999999999)", type:"tel"}
  ], function(inputs){
    S.nome = inputs.nome.value.trim();
    S.email = inputs.email.value.trim();
    S.tel = inputs.tel.value.replace(/\D/g,"");
    say(S.nome + " | " + S.email + " | " + S.tel, "me");
    confirm2();
  });
}

function confirm2(){
  say("Confira os dados:\n• Serviço: "+S.svc[0]+"\n• Data: "+lbl(S.date)+" às "+S.time+"\n• Cliente: "+S.nome+"\n• E-mail: "+S.email+"\n\nConfirmar agendamento?");
  chips([{t:"Sim, confirmar",ok:1},{t:"Começar de novo",ok:0}],function(it){
    if(it.ok) saveAndFinish(); else start();
  });
}

function saveAndFinish(){
  var dateKey = iso(S.date);
  var timeKey = S.time.replace(":","");
  
  db.ref('agendamentos/' + dateKey + '/' + timeKey).set({
    nome: S.nome,
    email: S.email,
    tel: S.tel,
    servico: S.svc[0],
    preco: S.svc[1],
    data: lbl(S.date),
    hora: S.time
  }, function(err){
    if(!err){
      say("Agendamento concluído! O horário foi reservado e bloqueado no sistema.");
      
      var m="Olá! Agendei pelo site:\n\nNome: "+S.nome+"\nE-mail: "+S.email+"\nServiço: "+S.svc[0]+"\nDia: "+lbl(S.date)+" às "+S.time;
      
      var h = parseInt(S.time.split(":")[0]);
      var min = parseInt(S.time.split(":")[1]);
      var dtStart = new Date(S.date.getFullYear(), S.date.getMonth(), S.date.getDate(), h, min);
      var dtEnd = new Date(dtStart.getTime() + S.svc[2]*60000);
      
      var fmt = function(d){ return d.toISOString().replace(/-|:|\.\d+/g, ""); };
      var icsData = "BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:" + S.svc[0] + " - Barbearia Di'Quebrada\n" +
                    "DESCRIPTION:Seu agendamento na Barbearia Di'Quebrada\n" +
                    "DTSTART:" + fmt(dtStart) + "\nDTEND:" + fmt(dtEnd) + "\n" +
                    "BEGIN:VALARM\nTRIGGER:-PT30M\nACTION:DISPLAY\nDESCRIPTION:Lembrete de Agendamento\nEND:VALARM\n" +
                    "END:VEVENT\nEND:VCALENDAR";
      
      var icsBlob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
      var icsUrl = URL.createObjectURL(icsBlob);

      ctl.innerHTML="";
      
      var aWa = document.createElement("a");
      aWa.className = "wa"; aWa.target = "_blank";
      aWa.href = "https://wa.me/" + SALON + "?text=" + encodeURIComponent(m);
      aWa.textContent = "Enviar confirmação no WhatsApp";
      ctl.appendChild(aWa);

      var aCal = document.createElement("a");
      aCal.className = "cal";
      aCal.href = icsUrl;
      aCal.download = "agendamento-di-quebrada.ics";
      aCal.textContent = "📅 Salvar na minha Agenda (Com Lembrete)";
      ctl.appendChild(aCal);

      var btnCancel = document.createElement("button");
      btnCancel.className = "del-btn";
      btnCancel.textContent = "❌ Cancelar este Agendamento";
      btnCancel.onclick = function(){ deleteBooking(dateKey, timeKey, true); };
      ctl.appendChild(btnCancel);
    }
  });
}

function cancelByClient(){
  say("Para cancelar, informe o WhatsApp cadastrado:");
  askMulti([{key:"tel", ph:"Seu WhatsApp com DDD", type:"tel"}], function(inputs){
    var searchTel = inputs.tel.value.replace(/\D/g,"");
    db.ref('agendamentos').once('value', function(snapshot){
      var data = snapshot.val();
      var found = [];
      for(var day in data){
        for(var time in data[day]){
          if(data[day][time].tel === searchTel){
            found.push({day: day, time: time, info: data[day][time]});
          }
        }
      }
      if(found.length === 0){
        say("Nenhum agendamento encontrado para este número.");
        chips([{t:"Tentar de novo", act:"cancel"},{t:"Início", act:"start"}], function(it){
          if(it.act === "cancel") cancelByClient(); else start();
        });
      } else {
        say("Encontramos os seguintes agendamentos:");
        ctl.innerHTML = "";
        found.forEach(function(item){
          var btn = document.createElement("button");
          btn.className = "del-btn";
          btn.textContent = "Cancelar: " + item.info.data + " às " + item.info.hora + " (" + item.info.servico + ")";
          btn.onclick = function(){ deleteBooking(item.day, item.time, true); };
          ctl.appendChild(btn);
        });
      }
    });
  });
}

function deleteBooking(dateKey, timeKey, isClient){
  if(confirm("Tem certeza que deseja cancelar e liberar este horário?")){
    db.ref('agendamentos/' + dateKey + '/' + timeKey).remove(function(err){
      if(!err){
        alert("Agendamento cancelado com sucesso!");
        if(isClient) start(); else openAdmin();
      } else {
        alert("Erro ao cancelar. Tente novamente.");
      }
    });
  }
}

function openAdmin(){
  var pass = prompt("Digite a senha do administrador:");
  if(pass !== ADMIN_PASS){ alert("Senha incorreta!"); return; }
  
  log.innerHTML = "<h3>Painel do Administrador</h3><p>Carregando dados...</p>";
  ctl.innerHTML = "<button class='send' onclick='start()'>Voltar ao Agendamento</button>";

  db.ref('agendamentos').once('value', function(snapshot){
    var data = snapshot.val();
    if(!data){
      log.innerHTML = "<h3>Painel do Administrador</h3><p>Nenhum agendamento realizado ainda.</p>";
      return;
    }
    
    var html = "<h3>Agendamentos Registrados</h3>";
    for(var day in data){
      for(var time in data[day]){
        var item = data[day][time];
        html += "<div class='admin-card'>" +
                  "<div class='admin-card-head'><span>📅 " + item.data + " às " + item.hora + "</span></div>" +
                  "<div class='admin-card-body'>" +
                    "<b>Cliente:</b> " + item.nome + "<br>" +
                    "<b>Serviço:</b> " + item.servico + "<br>" +
                    "<b>WhatsApp:</b> " + item.tel + "<br>" +
                    "<b>E-mail:</b> " + item.email +
                  "</div>" +
                  "<button class='btn-card-del' onclick=\"deleteBooking('"+day+"','"+time+"',false)\">🗑️ Excluir / Cancelar</button>" +
                "</div>";
      }
    }
    log.innerHTML = html;
  });
}

start();
</script>
</body>
</html>
